# Aurea Plast — clean URLs + performance/security (Hostinger Apache / LiteSpeed)

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Skip API and real static asset files
  RewriteRule ^api/ - [L]

  # 1. Direct single-hop 301: Strip /index.html directly to canonical root
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^index\.html$ https://aureaplastclinic.com/ [R=301,L]

  # 2. Direct single-hop 301: Strip .html extension directly to canonical URL
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
  RewriteRule ^ https://aureaplastclinic.com/%1 [R=301,L]

  # 3. Direct single-hop 301: Force HTTPS AND non-www in a single redirect hop
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://aureaplastclinic.com%{REQUEST_URI} [R=301,L]

  # 4. Internal clean URL rewrite: /page → /page.html when file exists
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# LiteSpeed Server Cache configuration (Hostinger LiteSpeed Web Server)
<IfModule LiteSpeed>
  CacheLookup on
  CacheCheckPrivate off
  CacheEngine on
  CacheEnable public /
  RewriteCond %{REQUEST_METHOD} ^(HEAD|GET)$
  RewriteCond %{REQUEST_URI} !^/(api)/
  RewriteRule .* - [E=Cache-Control:max-age=1800]
</IfModule>

# Compression (Brotli + Deflate/Gzip)
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# Browser caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # Long-cache immutable static assets
  <FilesMatch "\.(css|js|jpg|jpeg|png|webp|gif|ico|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>
