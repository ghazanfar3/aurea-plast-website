# Aurea Plast — clean URLs (Hostinger Apache / LiteSpeed)
# Serves /about from about.html and 301-redirects /about.html → /about

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Skip real files/directories and the API
  RewriteRule ^api/ - [L]

  # 301: /index.html → /
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [R=301,L]

  # 301: /page.html → /page (preserves query string)
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
  RewriteRule ^ %1 [R=301,L]

  # Internal rewrite: /page → /page.html when the HTML file exists
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>
